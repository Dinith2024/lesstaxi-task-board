# Copy this file to .env and fill in real values before running the server
# .env is git-ignored — never commit real secrets

# Port the HTTP server listens on
PORT=5175

# Secret used to sign/verify JWTs. Use a long random string in production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-this-with-a-long-random-secret

# How long issued tokens stay valid
JWT_EXPIRES_IN_SECONDS=86400

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5500

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/taskboard.db

# Credentials used ONLY by scripts/seedAdmin.js to create the administrator account
# Administrators are never created through the public registration endpoint
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@lesstaxi.local
ADMIN_PASSWORD=replace-with-a-strong-password